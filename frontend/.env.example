# SourceTrace Frontend Environment Variables
# Copy this file to .env.local for local development.

# Base URL for the SourceTrace Backend API
# For local development with Vite proxy: leave blank or set to ""
# For production (Vercel deployment): set to your deployed Render backend URL
# Example: VITE_API_BASE_URL=https://sourcetrace-backend.onrender.com
VITE_API_BASE_URL=
