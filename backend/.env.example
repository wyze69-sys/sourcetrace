# SourceTrace Backend Environment Variables
# Copy this file to .env and fill in values for local development.
# Never commit a .env file with real credentials to Git.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
SOURCETRACE_ENV=development
SOURCETRACE_LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Provider selection
# ---------------------------------------------------------------------------
# Valid values: "gemini" (default) | "openai"
# When set to "gemini", OpenAI credentials are not required.
# When set to "openai", Gemini credentials are not required.
SOURCETRACE_LLM_PROVIDER=gemini
SOURCETRACE_EMBEDDING_PROVIDER=gemini

# ---------------------------------------------------------------------------
# Google Gemini provider (default)
# ---------------------------------------------------------------------------
# Get a free API key at: https://aistudio.google.com/apikey
# Free-tier rate limits vary by model and project; check aistudio.google.com
# for current quotas. Typical free-tier limits: ~15 RPM (varies by model/project).
# Using the free tier means inputs/outputs may be used by Google for product
# improvement. Review Google's data usage policy before indexing private code.
SOURCETRACE_GEMINI_API_KEY=
SOURCETRACE_GEMINI_MODEL=gemini-2.5-flash
SOURCETRACE_GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# ---------------------------------------------------------------------------
# Embedding dimensions
# ---------------------------------------------------------------------------
# Must match the Atlas Vector Search index numDimensions setting (1536).
# gemini-embedding-001 natively outputs 3072 dims but supports output_dimensionality=1536.
# Do NOT change this unless you rebuild the Atlas Vector Search index with the new dimension.
SOURCETRACE_EMBEDDING_DIMENSIONS=1536
SOURCETRACE_EMBEDDING_BATCH_SIZE=100

# ---------------------------------------------------------------------------
# OpenAI provider (optional — only used when SOURCETRACE_LLM_PROVIDER=openai)
# ---------------------------------------------------------------------------
# Leave blank when using Gemini. These fields are ignored when provider=gemini.
# SOURCETRACE_LLM_API_KEY=
# SOURCETRACE_LLM_MODEL=gpt-4o-mini
# SOURCETRACE_EMBEDDING_API_KEY=
# SOURCETRACE_EMBEDDING_MODEL=text-embedding-3-small
# SOURCETRACE_LLM_BASE_URL=https://api.openai.com/v1

# ---------------------------------------------------------------------------
# MongoDB Atlas
# ---------------------------------------------------------------------------
SOURCETRACE_MONGODB_URI=
SOURCETRACE_MONGODB_DATABASE_NAME=sourcetrace

# ---------------------------------------------------------------------------
# Vector search
# ---------------------------------------------------------------------------
SOURCETRACE_VECTOR_INDEX_NAME=code_chunks_vector_index
SOURCETRACE_VECTOR_SEARCH_NUM_CANDIDATES=100
SOURCETRACE_VECTOR_SEARCH_MAX_LIMIT=50

# ---------------------------------------------------------------------------
# Session
# ---------------------------------------------------------------------------
# Must be at least 32 random characters in production.
SOURCETRACE_SESSION_SIGNING_SECRET=
SOURCETRACE_SESSION_COOKIE_NAME=sourcetrace_session
